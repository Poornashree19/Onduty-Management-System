<% include ./partial/header %><% include ./partial/acfunction %>
<div
  class="col-sm-6"
  style="    flex: 0 0 50%;
    max-width: 60%;
    margin-left: 431px;
    color:black;
    margin-top: -251px;  text-align: -webkit-center;"
>
  <form action="/ac/<%=ac.id%>/od/<%=student.id%>/info" method="POST">
    <div class="container-fluid bg-3 text-center">
      <h1 style="margin-top: 40px;"><%=student.name %></h1>
      <br />
      <div class="row">
        <div class="col-sm-4">
          <img
            style="height:150px;width:150px;border-radius: 100%"
            
          />
        </div>
        <%student.ods.forEach(function(od){%>
        <div class="col-sm-4" style="width: 100%">
          <h3><strong> Subject:</strong><%=od.subject %></h3>
          <h3>Status:<%=od.status %></h3>
          <h3>From:<%=moment(od.to).format('DD/MM/YYYY') %></h3>
          <h3>To:<%=moment(od.from).format('DD/MM/YYYY') %></h3>
          <h3><%=od.days%></h3>
          <h3>Department:<%=student.department %></h3>
          <div class="col-sm-6">
            <input
              type="submit"
              class="btn btn-block btn-orange"
              name="action"
              value="Approve"
            />
            <input
              type="submit"
              class="btn btn-block btn-danger"
              name="action"
              value="Deny"
            />
          </div>
        </div>

        <%})%>
      </div>
    </div>
  </form>
  <% include ./partial/footer %>
</div>

<% include ./partial/header %>
<div class="lop"style="border:1px solid pink;">
    <% if (locals.errors) { %>
      <div class="alert alert-danger" role="alert"style="">
        <% locals.errors.forEach(function(errors) { %>
        <h5><%= errors.msg %></h5>

        <% }); %>
      </div>
      <% } %>
</div>
<div
  class="container"
  style=" position: relative;
border-radius: 5px;
background-color: #f2f2f2;
padding: 60px 0 30px 0;
width: 40%;"

>


        

        <form action="/student/register" method="POST" style="margin: 0 auto;">
          <div class="row">
            <div class="col">
              <center>
                <img src="https://srec.ac.in/uploads/resource/src/WOea5eyA6k30062017092236srec-logo.jpg" style="width:180px;height:180px;border-radius: 50%;">
                </center>
              <h3 style="font: black;color:black; font-family: 'Times New Roman', Times, serif;border-radius: 50%;"><center>
                SRI RAMAKRISHNA ENGINEERING COLLEGE.<br>
                VATTAMALAIPALAYAM,COIMBATORE.
                <hr>
              </center></h3>
              <h2 style="  color:black;
              background-color:orange;
              text-align: center;
              font-family: 'Times New Roman', Times, serif;
              padding:15px;">
                Register
              </h2>
              
              <div class="form-group form-inline">
                <label for="name" style="width: 200px;
                display: inline-block;
                text-align: right;
                ">Name: </label>
                <input
                  class="form-control"
                  type="text"
                  id="name"
                  placeholder="name"
                  name="name"
                  style="float: left;;
                  text-align: left;
                  "
                />
              </div>
              
              <div id="rates" class="form-group"style="width: 400px;
              display: inline-block;
              text-align: right;
              ">
                <input type="radio" id="r1" name="type" value="student" />
                Student
                <input type="radio" id="r2" name="type" value="ac" />
                Tutor/AC
                <input type="radio" id="r3" name="type" value="hod" />
                HOD
              </div>

              
              <div class="form-group form-inline">
                  <label for="rollno" style="width: 200px;
                  display: inline-block;
                  text-align: right;
                  ">Username: </label>
                <input
                  class="form-control"
                  type="number"
                  id="username"
                  placeholder="rollno"
                  name="username"
                />
              </div>
              
              <div class="form-group form-inline">
                  <label for="password"style="width: 200px;
                  display: inline-block;
                  text-align: right;
                  ">Password: </label>
                <input
                  class="form-control"
                  type="password"
                  name="password"
                  id="password"
                  placeholder="password"
                />
              </div>
              
              <div class="form-group form-inline">
                  <label for="cpassword"style="width: 200px;
                  display: inline-block;
                  text-align: right;
                  ">Confirm Password: </label>
                <input
                  class="form-control"
                  type="password"
                  id="cpassword"
                  name="password2"
                  placeholder="Confirm password"
                />
              </div>
              
              <div class="form-group form-inline">
                  <label for="department"style="width: 200px;
                  display: inline-block;
                  text-align: right;
                  ">Department: </label>
                
                <input
                  class="form-control"
                  
                  type="text"
                  placeholder="Department"
                  id="department"
                  name="department"
                />
              </div>
       
         

              <div class="form-group">
                <button
                  type="submit"
                  class="btn btn-lg btn-primary btn-default btn-block"
                  style=" color:white; background-color: orange;"
                  
                >
                  Submit
                </button>
              </div>
            </div>
          </div>
          
        </form>

        <a href="/" >Back</a>
      </div>
    </div>
  </div>
  <% include ./partial/footer %>
</div>

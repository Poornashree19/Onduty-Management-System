<% include ./partial/header %>
<div
  class="col-sm-9"
  style="margin: 50px 125px;    text-align: -webkit-center; "
>
  <form
    action="/hod/<%=hod.id%>/od/<%=student.id%>/info"
    method="POST"
  >
    <div
      class="container-fluid bg-3 text-center"
      style="color: black;"
    >
      <h1><%=student.name %></h1>
      <br />
      <div class="row">
        
        <%student.ods.forEach(function(od){%>
        <div class="col-sm-4">
          <h3><strong> Subject:</strong><%=od.subject %></h3>
          <h3>Status:<%=od.hodstatus %></h3>
          <h3>From:<%=moment(od.to).format('DD/MM/YYYY') %></h3>
          <h3>To:<%=moment(od.from).format('DD/MM/YYYY') %></h3>
          <h3><%=od.days%></h3>
        
          <h3>Department:<%=student.department %></h3>
          <div style="float:inherit">
            <input
              type="submit"
              class="btn btn-block btn-orange"
              name="action"
              value="Approve"
            />
            <input
              type="submit"
              class="btn btn-block btn-danger"
              name="action"
              value="Decline"
            />
          </div>
        </div>

        <%})%>
      </div>
    </div>
  </form>
</div>
<% include ./partial/footer %>
